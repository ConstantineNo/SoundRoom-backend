#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
python_bin=${1:-python3.12}
mkdir -p .runtime/tmp .runtime/cache
export TMPDIR="$PWD/.runtime/tmp"
export PIP_CACHE_DIR="$PWD/.runtime/cache/pip"
"$python_bin" -c 'import sys; assert sys.version_info[:2] == (3, 12), "Use Python 3.12"'
"$python_bin" -m venv .venv-recognition
.venv-recognition/bin/python -m pip install -r requirements-recognition-lab.lock.txt
.venv-recognition/bin/python -m pip check
